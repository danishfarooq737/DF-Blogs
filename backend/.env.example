# Backend (Express API) environment. Copy to backend/.env
# Frontend variables live in frontend/.env (see frontend/.env.example)

# ── Server ────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/df-blogs
# Public URL of the React app - exact origin, no trailing path (used for CORS, sitemap and the Origin/CSRF check).
# PRODUCTION: must be the https:// URL, e.g. https://df-blogs.onrender.com  (http:// is auto-upgraded, localhost is refused)
CLIENT_URL=http://localhost:5173
# Public URL of this API (used to build image URLs).
# PRODUCTION: must be the https:// URL, e.g. https://df-blogs-api.onrender.com
# (on Render it falls back to RENDER_EXTERNAL_URL if left empty). An http:// URL here causes "mixed content" errors.
SERVER_URL=http://localhost:5000
# Number of reverse proxies in front of the API so rate limits see real client IPs.
# Defaults to 1 when NODE_ENV=production (Render/Heroku/nginx), 0 otherwise.
TRUST_PROXY=0

# ── Authentication ────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# In production these must be random, unique, and at least 32 characters.
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
# Cookies: leave as "lax" when the site and API share a domain (recommended, use a proxy/rewrite).
# Use "none" only for genuinely cross-site deployments (requires HTTPS).
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

# ── Image storage ─────────────────────────────────────────
# local | cloudinary
# PRODUCTION on Render: use cloudinary - Render's disk is wiped on every deploy, so local uploads would disappear.
IMAGE_STORAGE=local
MAX_UPLOAD_MB=2
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=df-blogs

# ── Site identity (shown on Contact / legal pages and used for SEO) ──
SITE_NAME=DF Blogs
SITE_DESCRIPTION=Practical articles on engineering, design, security and search from the DF Blogs editorial team.
SITE_CONTACT_EMAIL=hello@dfblogs.example
SITE_CONTACT_PHONE=
# Leave empty until you have an official address; the Contact page then shows a clearly marked placeholder.
SITE_ADDRESS=
SITE_LEGAL_ENTITY=DF Blogs

# ── Analytics (optional; only loaded after the visitor accepts cookies) ──
# none | plausible | ga4
ANALYTICS_PROVIDER=none
# plausible: your site domain (e.g. blog.example.com)   ga4: measurement id (G-XXXXXXXXXX)
ANALYTICS_ID=
ANALYTICS_SCRIPT_URL=https://plausible.io/js/script.js

# Directory for IMAGE_STORAGE=local (optional). On Render with a paid persistent disk, point this at the mount path, e.g. /var/data/uploads
UPLOAD_DIR=

# ── Seeding (development only) ────────────────────────────
SEED_PASSWORD=Password@123
