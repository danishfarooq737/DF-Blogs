# Environment variables for the Render *web service* (df-blogs-api).
# Set these in Render > Service > Environment. NEVER commit real values. Do NOT upload backend/.env.

NODE_ENV=production
TRUST_PROXY=1

# MongoDB Atlas: Database > Connect > Drivers. Also allow Render in Atlas > Network Access (0.0.0.0/0 is simplest).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/df-blogs?retryWrites=true&w=majority

# Both MUST be https:// and must NOT be localhost (the server refuses to start otherwise).
CLIENT_URL=https://df-blogs.onrender.com
SERVER_URL=https://df-blogs-api.onrender.com

# 32+ random characters each, different from each other:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Site and API are served from one origin through the static site's rewrite rules -> keep "lax".
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=

IMAGE_STORAGE=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=df-blogs
MAX_UPLOAD_MB=2

SITE_NAME=DF Blogs
SITE_CONTACT_EMAIL=you@yourdomain.com
