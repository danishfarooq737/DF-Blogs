# Frontend (React + Vite) environment. Copy to frontend/.env
# Only variables prefixed with VITE_ are exposed to the browser - never put secrets here.
# These are read at BUILD time (Render static sites bake them into the bundle).

# Full https:// URL of the API, ONLY if the API lives on a different origin than the website.
# Leave EMPTY (recommended):
#   - in development: requests to /api go through the Vite proxy
#   - on Render: the static site rewrites /api and /uploads to the backend (see render.yaml)
# Never use http:// or localhost here for a production build - that causes "mixed content" errors.
VITE_API_URL=

# Dev server only: where the Vite proxy forwards /api and /uploads (must match backend PORT)
VITE_DEV_PROXY_TARGET=http://localhost:5000
